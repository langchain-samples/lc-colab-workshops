# Copy to .env at the repo root, then fill in. Only the first line is required.
#
#   cp .env.example .env
#
# On Colab these live in the 🔑 Secrets panel instead, with "Notebook access" on.

# https://smith.langchain.com/settings/apikeys — Personal Access Token, starts with lsv2_pt_
LANGSMITH_API_KEY=

# Optional. Only for workspaces that issue a separate key for the model gateway.
# Left unset, model calls use LANGSMITH_API_KEY above.
# LANGSMITH_GATEWAY_API_KEY=
