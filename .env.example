# Copy to .env and fill in. Only LANGSMITH_API_KEY is required.
# On Colab these go in the 🔑 Secrets panel instead, with "Notebook access" on.

# https://smith.langchain.com/settings/apikeys
LANGSMITH_API_KEY=

# Optional. A separate key for the model gateway.
# LANGSMITH_GATEWAY_API_KEY=

# Optional, local only. Set it if your key can reach more than one workspace,
# or traces 403 while everything else works.
# LANGSMITH_WORKSPACE_ID=
